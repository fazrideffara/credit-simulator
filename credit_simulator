#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Support execution from root or bin directory
if [ -d "$SCRIPT_DIR/target" ]; then
    ROOT_DIR="$SCRIPT_DIR"
elif [ -d "$SCRIPT_DIR/../target" ]; then
    ROOT_DIR="$SCRIPT_DIR/.."
else
    ROOT_DIR="$SCRIPT_DIR"
fi

cd "$ROOT_DIR"
JAR_PATH="target/credit-simulator.jar"

need_build=0
if [ ! -f "$JAR_PATH" ]; then
    need_build=1
elif [ -n "$(find src pom.xml -newer "$JAR_PATH" -print -quit 2>/dev/null)" ]; then
    need_build=1
fi

if [ "$need_build" -eq 1 ]; then
    echo "[BUILD] Menyusun ulang credit_simulator..."
    if command -v mvn &> /dev/null; then
        mvn -q package -DskipTests
    elif [ -f "./mvnw" ]; then
        ./mvnw -q package -DskipTests
    else
        echo "[ERROR] Maven (mvn) required to build credit_simulator."
        exit 1
    fi
fi

if [ $# -gt 0 ]; then
    java -jar "$JAR_PATH" "$1"
else
    java -jar "$JAR_PATH"
fi
